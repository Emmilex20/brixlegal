# Public Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server-only Supabase key. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Resend email delivery
RESEND_API_KEY=re_xxxxxxxxx
BRIX_EMAIL_FROM=Brix Legal <consultations@your-domain.example>
BRIX_ADMIN_EMAIL=consultations@your-domain.example

# Canonical production origin used in email tracking/admin links.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Long random secret used by /api/cron/reminders.
CRON_SECRET=replace-with-a-long-random-secret
